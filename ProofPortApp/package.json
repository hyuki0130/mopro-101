{
  "name": "ProofPortApp",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "android": "react-native run-android",
    "ios": "react-native run-ios",
    "ios:device": "react-native run-ios --device",
    "ios:build": "cd ios && xcodebuild -workspace ProofPortApp.xcworkspace -scheme ProofPortApp -configuration Debug -sdk iphonesimulator -arch arm64 build ONLY_ACTIVE_ARCH=YES CODE_SIGNING_ALLOWED=NO",
    "ios:install": "xcrun simctl install booted /Users/nhn/Library/Developer/Xcode/DerivedData/ProofPortApp-*/Build/Products/Debug-iphonesimulator/ProofPortApp.app",
    "ios:launch": "xcrun simctl launch booted org.reactjs.native.example.ProofPortApp",
    "ios:run": "npm run ios:build && npm run ios:install && npm run ios:launch",
    "lint": "eslint .",
    "start": "react-native start",
    "test": "jest",
    "assets": "npx react-native-asset",
    "pod-install": "cd ios && LANG=en_US.UTF-8 LC_ALL=en_US.UTF-8 pod install && cd ..",
    "postinstall": "patch-package"
  },
  "dependencies": {
    "@metamask/sdk-react-native": "^0.3.12",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-navigation/native": "^7.1.25",
    "@react-navigation/native-stack": "^7.8.6",
    "eciesjs": "^0.4.16",
    "ethers": "^5.7.2",
    "mopro-ffi": "file:./mopro_bindings",
    "node-libs-react-native": "^1.2.1",
    "react": "19.1.0",
    "react-native": "0.81.4",
    "react-native-background-timer": "^2.4.1",
    "react-native-fs": "^2.20.0",
    "react-native-get-random-values": "^2.0.0",
    "react-native-randombytes": "^3.6.2",
    "react-native-safe-area-context": "^5.6.2",
    "react-native-screens": "^4.18.0",
    "react-native-url-polyfill": "^3.0.0"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/preset-env": "^7.25.3",
    "@babel/runtime": "^7.25.0",
    "@react-native/babel-preset": "0.81.4",
    "@react-native/eslint-config": "^0.81.1",
    "@react-native/metro-config": "0.81.4",
    "@react-native/typescript-config": "0.81.4",
    "@types/jest": "^29.5.13",
    "@types/react": "^19.1.0",
    "@types/react-test-renderer": "^19.1.0",
    "eslint": "^8.19.0",
    "jest": "^29.6.3",
    "patch-package": "^8.0.1",
    "prettier": "2.8.8",
    "react-test-renderer": "19.1.0",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": ">=20"
  }
}
